{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rebaze.local/preflight/schemas/report-v1.json",
  "title": "Preflight local feedback report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "authority",
    "runId",
    "startedAt",
    "finishedAt",
    "current",
    "subject",
    "policy",
    "runtime",
    "scope",
    "findings",
    "summary",
    "exitCode"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "init",
        "explain",
        "prepare",
        "check",
        "status"
      ]
    },
    "authority": {
      "type": "string",
      "const": "local-feedback"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "current": {
      "type": "boolean"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoRoot",
        "baselineCommit",
        "comparisonBase",
        "head",
        "mergeBase",
        "snapshotDigest",
        "excludedCategories",
        "changedPaths",
        "outOfScopePaths"
      ],
      "properties": {
        "repoRoot": {
          "type": "string"
        },
        "baselineCommit": {
          "type": "string"
        },
        "comparisonBase": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "mergeBase": {
          "type": "string"
        },
        "snapshotDigest": {
          "type": "string"
        },
        "excludedCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outOfScopePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageDigest",
        "profileDigest",
        "baselineCommit"
      ],
      "properties": {
        "packageDigest": {
          "type": "string"
        },
        "profileDigest": {
          "type": "string"
        },
        "baselineCommit": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluatorDigest",
        "evaluatorVersion",
        "runnerImageId",
        "preparationInputDigest"
      ],
      "properties": {
        "evaluatorDigest": {
          "type": "string"
        },
        "evaluatorVersion": {
          "type": "string"
        },
        "runnerImageId": {
          "type": "string"
        },
        "preparationInputDigest": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "deferred",
        "excluded"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "controlId",
          "status",
          "reasonCode",
          "message",
          "paths",
          "evidence",
          "owner",
          "nextActions"
        ],
        "properties": {
          "controlId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "missing",
              "error",
              "review_required",
              "deferred",
              "not_applicable"
            ]
          },
          "reasonCode": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "digest",
                "path"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "digest": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              }
            }
          },
          "owner": {
            "type": "string"
          },
          "nextActions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "command",
                "args"
              ],
              "properties": {
                "description": {
                  "type": "string"
                },
                "command": {
                  "type": "string"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "missing",
        "error",
        "review_required",
        "deferred",
        "not_applicable"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "review_required": {
          "type": "integer",
          "minimum": 0
        },
        "deferred": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "exitCode": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ]
    }
  }
}
