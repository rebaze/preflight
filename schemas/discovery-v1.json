{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rebaze/preflight/schemas/discovery-v1.json",
  "title": "Preflight discovery v1",
  "$ref": "#/$defs/Discovery",
  "$defs": {
    "Discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority",
        "observedAt",
        "subject",
        "inputs",
        "sources",
        "changes",
        "claims",
        "coverage",
        "diagnostics",
        "exitCode"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "const": "preflight.discovery/v1"
        },
        "authority": {
          "type": "string",
          "const": "local-feedback"
        },
        "observedAt": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/DiscoverySubject"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryInput"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoverySource"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryChange"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryClaim"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryCoverage"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryDiagnostic"
          }
        },
        "exitCode": {
          "type": "integer",
          "enum": [
            0,
            2,
            3
          ]
        },
        "github": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscoveryGitHub"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscoveryComparison"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DiscoverySubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoRoot",
        "repositoryId",
        "worktreeId",
        "head",
        "branch",
        "baseRef",
        "baseCommit",
        "mergeBase",
        "indexDigest",
        "inputDigest",
        "dirty",
        "current"
      ],
      "properties": {
        "repoRoot": {
          "type": "string"
        },
        "repositoryId": {
          "type": "string"
        },
        "worktreeId": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "baseRef": {
          "type": "string"
        },
        "baseCommit": {
          "type": "string"
        },
        "mergeBase": {
          "type": "string"
        },
        "indexDigest": {
          "type": "string"
        },
        "inputDigest": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "current": {
          "type": "boolean"
        }
      }
    },
    "DiscoveryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "digest",
        "mode"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "mode": {
          "type": "integer"
        }
      }
    },
    "DiscoverySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "digest",
        "content",
        "startLine",
        "endLine",
        "mode"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "startLine": {
          "type": "integer"
        },
        "endLine": {
          "type": "integer"
        },
        "mode": {
          "type": "integer"
        }
      }
    },
    "DiscoveryChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "layer",
        "status",
        "before",
        "after"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "layer": {
          "type": "string",
          "enum": [
            "committed",
            "staged",
            "unstaged",
            "untracked"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "deleted"
          ]
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        }
      }
    },
    "DiscoveryReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "line"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "DiscoveryClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "verification",
        "summary",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "enum": [
            "documented",
            "configured",
            "inferred",
            "observed"
          ]
        },
        "verification": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "unknown",
            "stale"
          ]
        },
        "summary": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryReference"
          }
        }
      }
    },
    "DiscoveryCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector",
        "status",
        "detail"
      ],
      "properties": {
        "collector": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "not_requested"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "DiscoveryDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "DiscoveryGitHub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "observed_at",
        "target_branch",
        "target_source",
        "pull_request",
        "head",
        "head_repository",
        "merge_candidate",
        "evidence_revision",
        "evidence_subject",
        "local_coverage",
        "rules",
        "requirements",
        "results",
        "matches",
        "coverage"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        },
        "target_branch": {
          "type": "string"
        },
        "target_source": {
          "type": "string",
          "enum": [
            "",
            "default_branch",
            "comparison_base",
            "pull_request_base"
          ]
        },
        "pull_request": {
          "type": "integer"
        },
        "head": {
          "type": "string"
        },
        "head_repository": {
          "type": "string"
        },
        "merge_candidate": {
          "type": "string"
        },
        "evidence_revision": {
          "type": "string"
        },
        "evidence_subject": {
          "type": "string",
          "enum": [
            "unknown",
            "head",
            "merge_candidate"
          ]
        },
        "local_coverage": {
          "type": "string",
          "enum": [
            "unknown",
            "stale_local_edits",
            "revision_mismatch",
            "clean_head_only",
            "incomplete_local_identity"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryGitHubRule"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryGitHubRequirement"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryGitHubResult"
          }
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryGitHubMatch"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryGitHubCoverage"
          }
        }
      }
    },
    "DiscoveryGitHubCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "status",
        "detail",
        "source",
        "observed_at"
      ],
      "properties": {
        "resource": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "unavailable",
            "unsupported",
            "error",
            "denied",
            "inaccessible",
            "limited",
            "ambiguous",
            "unknown"
          ]
        },
        "detail": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        }
      }
    },
    "DiscoveryGitHubRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source",
        "source_type",
        "ruleset_id",
        "supported",
        "review_count",
        "code_owner_review",
        "dismiss_stale_reviews",
        "last_push_approval",
        "strict_checks",
        "observed_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "ruleset_id": {
          "type": "integer"
        },
        "supported": {
          "type": "boolean"
        },
        "review_count": {
          "type": "integer"
        },
        "code_owner_review": {
          "type": "boolean"
        },
        "dismiss_stale_reviews": {
          "type": "boolean"
        },
        "last_push_approval": {
          "type": "boolean"
        },
        "strict_checks": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string"
        }
      }
    },
    "DiscoveryGitHubRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule_id",
        "context",
        "app_id",
        "producer",
        "source",
        "observed_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "app_id": {
          "type": "integer"
        },
        "producer": {
          "type": "string",
          "enum": [
            "any",
            "app"
          ]
        },
        "source": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        }
      }
    },
    "DiscoveryGitHubResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "revision",
        "repository",
        "app_id",
        "app_slug",
        "creator",
        "state",
        "conclusion",
        "completed_at",
        "updated_at",
        "source",
        "observed_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "check_run",
            "commit_status"
          ]
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "app_id": {
          "type": "integer"
        },
        "app_slug": {
          "type": "string"
        },
        "creator": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        },
        "completed_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "commit_status"
              }
            }
          },
          "then": {
            "properties": {
              "app_id": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "DiscoveryGitHubMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "revision",
        "status",
        "result_ids",
        "detail"
      ],
      "properties": {
        "requirement_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "matched",
            "missing",
            "failed",
            "unknown",
            "stale",
            "pending"
          ]
        },
        "result_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "DiscoveryComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible",
        "reason",
        "previousObservedAt",
        "currentObservedAt",
        "previousEvidenceStale",
        "inputChanges",
        "requirementChanges",
        "newFindings",
        "resolvedFindings",
        "evidence",
        "structural",
        "resolvedStructural",
        "notes"
      ],
      "properties": {
        "compatible": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "previousObservedAt": {
          "type": "string"
        },
        "currentObservedAt": {
          "type": "string"
        },
        "previousEvidenceStale": {
          "type": "boolean"
        },
        "inputChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryInputChange"
          }
        },
        "requirementChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryValueChange"
          }
        },
        "newFindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryFinding"
          }
        },
        "resolvedFindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryFinding"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryEvidenceTransition"
          }
        },
        "structural": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryCIExplanation"
          }
        },
        "resolvedStructural": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryCIExplanation"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DiscoveryInputChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "change",
        "beforeKind",
        "afterKind",
        "beforeDigest",
        "afterDigest",
        "beforeMode",
        "afterMode"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "change": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "removed",
            "unknown"
          ]
        },
        "beforeKind": {
          "type": "string"
        },
        "afterKind": {
          "type": "string"
        },
        "beforeDigest": {
          "type": "string"
        },
        "afterDigest": {
          "type": "string"
        },
        "beforeMode": {
          "type": "integer"
        },
        "afterMode": {
          "type": "integer"
        }
      }
    },
    "DiscoveryValueChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "change",
        "before",
        "after",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "claim",
            "required_check",
            "rule"
          ]
        },
        "change": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "removed",
            "unknown"
          ]
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "DiscoveryFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status",
        "summary",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "DiscoveryEvidenceTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "beforeStatus",
        "afterStatus",
        "beforeRevision",
        "afterRevision",
        "beforeObservedAt",
        "afterObservedAt",
        "comparable",
        "lastObservedPassing",
        "firstObservedFailing",
        "detail"
      ],
      "properties": {
        "requirementId": {
          "type": "string"
        },
        "beforeStatus": {
          "type": "string",
          "enum": [
            "passing",
            "failing",
            "unknown",
            "stale",
            "pending",
            "missing"
          ]
        },
        "afterStatus": {
          "type": "string",
          "enum": [
            "passing",
            "failing",
            "unknown",
            "stale",
            "pending",
            "missing"
          ]
        },
        "beforeRevision": {
          "type": "string"
        },
        "afterRevision": {
          "type": "string"
        },
        "beforeObservedAt": {
          "type": "string"
        },
        "afterObservedAt": {
          "type": "string"
        },
        "comparable": {
          "type": "boolean"
        },
        "lastObservedPassing": {
          "type": "string"
        },
        "firstObservedFailing": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "DiscoveryCIExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "beforeLine",
        "afterLine",
        "before",
        "after",
        "requirementId",
        "verification",
        "detail"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "workflow_deleted",
            "pr_trigger_removed",
            "required_job_deleted",
            "unsupported_structure"
          ]
        },
        "path": {
          "type": "string"
        },
        "beforeLine": {
          "type": "integer"
        },
        "afterLine": {
          "type": "integer"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "requirementId": {
          "type": "string"
        },
        "verification": {
          "type": "string",
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
